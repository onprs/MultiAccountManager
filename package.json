{
  "name": "account-vault",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.22.2 <25"
  },
  "scripts": {
    "dev": "tsx scripts/build-crypto-worker.ts && next dev",
    "build": "tsx scripts/build-crypto-worker.ts && next build && tsx scripts/build-runtime.ts && tsx scripts/assemble-release.ts",
    "build:crypto-worker": "tsx scripts/build-crypto-worker.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "build:release": "tsx scripts/assemble-release.ts",
    "start": "next start",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:passkey": "playwright test --config playwright.passkey.config.ts",
    "test:worker-runtime": "tsx scripts/verify-worker-runtime.ts",
    "runtime:reconfigure-domain": "tsx src/runtime/reconfigure-domain.ts",
    "runtime:provision-sub2api": "tsx src/runtime/provision-sub2api-connection.ts",
    "worker": "tsx src/worker/index.ts",
    "supervisor": "tsx src/runtime/supervisor.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-table": "8.21.3",
    "@zxing/browser": "0.2.1",
    "better-auth": "1.6.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hash-wasm": "4.12.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide-react": "1.24.0",
    "next": "16.3.3",
    "otpauth": "9.5.1",
    "pg-boss": "12.26.0",
    "postgres": "3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.81.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
